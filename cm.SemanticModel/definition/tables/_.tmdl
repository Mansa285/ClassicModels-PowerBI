		sourceColumn: [Is Weekend]

		annotation SummarizationSetBy = Automatic

	partition _ = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( MIN(orders[orderDate]), MAX(orders[orderDate]) ),
				    "Year", YEAR ( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM" ),
				    "Short Month", FORMAT ( [Date], "MMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Year-Quarter", FORMAT ( [Date], "YYYY" ) & "-Q" & FORMAT ( [Date], "Q" ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Month-Year", FORMAT ( [Date], "MMM YYYY" ),
				    "Day", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "DDDD" ),
				    "Short Day", FORMAT ( [Date], "DDD" ),
				    "Day No", WEEKDAY ( [Date], 2 ),
				    "Week No", WEEKNUM ( [Date], 2 ),
				    "Start of Month", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "End of Month", EOMONTH ( [Date], 0 ),
				    "Is Weekend",
				        IF ( WEEKDAY ( [Date], 2 ) > 5, "Yes", "No" )
				)

	annotation PBI_Id = 60f311fb6ff341c0a64f87453aa0f6b3

